# Supabase – lokal via `supabase start` (Supabase CLI) oder aus dem Supabase Cloud Projekt
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur server-seitig verwenden (z.B. Admin-Panel, Seed-Skripte) – NIEMALS an den Client senden
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT-Secret des Supabase-Projekts. Wird zum Signieren der eigenen
# Session-JWTs (Login ueber Name+PIN, siehe lib/auth/session.ts) verwendet,
# DAMIT PostgREST das Token akzeptiert und auth.uid()/auth.role() in den
# RLS-Policies funktionieren. Zu finden unter Supabase Dashboard -> Project
# Settings -> API -> JWT Settings -> "Legacy JWT Secret", bzw. lokal per
# `supabase status` (Feld "JWT secret").
SUPABASE_JWT_SECRET=change-me-to-the-supabase-project-jwt-secret
