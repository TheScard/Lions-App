# Supabase – lokal via `supabase start` (Supabase CLI) oder aus dem Supabase Cloud Projekt
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nur server-seitig verwenden (z.B. Admin-Panel, Seed-Skripte) – NIEMALS an den Client senden
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT-Secret des Supabase-Projekts. Wird zum Signieren der eigenen
# Session-JWTs (Login ueber Name+PIN, siehe lib/auth/session.ts) verwendet,
# DAMIT PostgREST das Token akzeptiert und auth.uid()/auth.role() in den
# RLS-Policies funktionieren. Zu finden unter Supabase Dashboard -> Project
# Settings -> API -> JWT Settings -> "Legacy JWT Secret", bzw. lokal per
# `supabase status` (Feld "JWT secret").
SUPABASE_JWT_SECRET=change-me-to-the-supabase-project-jwt-secret

# Web Push (eigenes VAPID-Setup, ohne Drittanbieter). Schluessel erzeugen
# mit `npx web-push generate-vapid-keys`. Details siehe docs/push-setup.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change-me-to-the-generated-vapid-public-key
VAPID_PRIVATE_KEY=change-me-to-the-generated-vapid-private-key
VAPID_SUBJECT=mailto:info@lions-adenau.de

# Basis-URL der App (ohne abschliessenden Slash), fuer die Links in
# Push-Benachrichtigungen (z.B. https://lions-adenau.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Schuetzt den Cron-Endpoint /api/cron/reminders. Erzeugen z.B. mit
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Vercel schickt diesen Wert automatisch als "Authorization: Bearer ..."
# Header mit, sobald er in den Projekt-Env-Variablen gesetzt ist.
CRON_SECRET=change-me-to-a-long-random-value

# Sicherheitsschalter fuer lokale Entwicklung: lokale .env.local-Dateien
# zeigen oft auf die LIVE-Datenbank mit echten Mitgliedern und echten
# Push-Abos. Mit PUSH_DRY_RUN=true schreibt lib/push.ts den Versand nur ins
# Log statt ihn tatsaechlich auszufuehren. NIEMALS in Vercel/Production
# setzen.
PUSH_DRY_RUN=true
